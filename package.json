{
  "name": "@brig-id/app",
  "description": "brig·id — Qwik UI: login, register, and passkey management (WebAuthn)",
  "engines": {
    "node": "^18.17.0 || ^20.3.0 || >=21.0.0"
  },
  "engines-annotation": "Mostly required by sharp which needs a Node-API v9 compatible runtime",
  "packageManager": "pnpm@11.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "qwik build",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.server": "qwik check-client src dist && vite build -c adapters/static/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "deploy": "echo 'Static site generated by \"pnpm build\" into dist/ — served by server-leaf, no separate deploy target'",
    "dev": "vite --mode ssr",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "oxlint src",
    "test": "vitest run",
    "test.watch": "vitest",
    "test.e2e": "playwright test",
    "typecheck": "tsc --incremental --noEmit",
    "preview": "qwik build preview && vite preview --open",
    "start": "vite --open --mode ssr",
    "qwik": "qwik"
  },
  "devDependencies": {
    "@builder.io/qwik": "1.20.3",
    "@builder.io/qwik-city": "1.20.3",
    "@playwright/test": "^1.62.1",
    "@types/node": "20.19.0",
    "ignore": "^7.0.6",
    "oxlint": "^1.76.0",
    "prettier": "3.6.2",
    "typescript": "7.0.2",
    "typescript-plugin-css-modules": "5.3.0",
    "undici": "8.12.4",
    "vite": "^7.3.7",
    "vite-tsconfig-paths": "4.3.2",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "@web.awesome.me/webawesome-pro": "3.11.0",
    "helpers4": "3.1.12"
  }
}
