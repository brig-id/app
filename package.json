{
  "name": "@brig-id/app",
  "version": "0.2.0",
  "description": "brig·id — the web interface: sign-in, account and passkeys",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": "^18.17.0 || ^20.3.0 || >=21.0.0"
  },
  "packageManager": "pnpm@11.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "qwik build && node scripts/csp-hashes.mjs && node scripts/check-origins.mjs",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.server": "qwik check-client src dist && vite build -c adapters/ssg/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "deploy": "echo 'Static site generated by \"pnpm build\" into dist/, served by a brig·id server: no separate deploy target'",
    "dev": "vite --mode ssr",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "oxlint src",
    "test": "vitest run",
    "test.watch": "vitest",
    "test.e2e": "playwright test",
    "typecheck": "tsc --incremental --noEmit",
    "preview": "qwik build preview && vite preview --open",
    "start": "vite --open --mode ssr",
    "qwik": "qwik",
    "csp-hashes": "node scripts/csp-hashes.mjs",
    "icons": "node scripts/icons.mjs",
    "check-origins": "node scripts/check-origins.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@iconify-json/ph": "^1.2.2",
    "@playwright/test": "^1.62.1",
    "@qwik.dev/core": "2.0.0-rc.5",
    "@qwik.dev/router": "2.0.0-rc.5",
    "@types/node": "20.19.0",
    "ignore": "^7.0.6",
    "oxlint": "^1.76.0",
    "prettier": "3.6.2",
    "typescript": "7.0.2",
    "typescript-plugin-css-modules": "5.3.0",
    "undici": "8.12.4",
    "vite": "8.2.4",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "helpers4": "3.1.12"
  }
}
